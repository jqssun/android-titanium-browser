{
  "manifest_version": 3,
  "name": "Flash Player",
  "description": "In-page video overlay for Flash Browser.",
  "version": "1.0",
  "key": "",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["flashplayer.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
